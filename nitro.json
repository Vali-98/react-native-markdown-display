{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "markdown"
  ],
  "ios": {
    "iosModuleName": "ValiMarkdown"
  },
  "android": {
    "androidNamespace": [
      "valimarkdown"
    ],
    "androidCxxLibName": "ValiMarkdown"
  },
  "autolinking": {
    "MarkdownEngine": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridMarkdownEngine"
      }
    }
  },
  "ignorePaths": [
    "node_modules",
    "lib"
  ]
}
