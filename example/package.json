{
  "name": "vali-markdown-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "pod": "pod install --project-directory=ios",
    "typecheck": "tsc --noEmit",
    "prestart": "npm --prefix .. run patch:legacy",
    "preandroid": "npm --prefix .. run patch:legacy",
    "preios": "npm --prefix .. run patch:legacy && npm run pod"
  },
  "dependencies": {
    "@react-native-community/slider": "^5.2.2",
    "@react-native/new-app-screen": "0.86.0",
    "@vali98/react-native-markdown-display": "file:..",
    "ratex-react-native": "^0.1.15",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-worklets": "^0.13.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "babel-plugin-module-resolver": "^5.0.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "vali-markdown": {
    "enableCodeHighlight": true,
    "codeHighlightLanguages": [
      "json",
      "html",
      "css",
      "markdown",
      "yaml",
      "go",
      "java",
      "javascript",
      "python",
      "c",
      "rust",
      "bash",
      "typescript",
      "tsx",
      "cpp"
    ]
  }
}
