-export default function parser(source, renderer, markdownIt) {
+export default function parser(source, renderer, markdownIt, onPerformance) {
+  if (onPerformance && !Array.isArray(source)) {
+    const start = performance.now();
+    let mark = start;
+    const stages = {};
+    const measure = (name, operation) => {
+      const value = operation();
+      const now = performance.now();
+      stages[name] = now - mark;
+      mark = now;
+      return value;
+    };
+    let tokens = measure('tokenizeMs', () => stringToTokens(source, markdownIt));
+    tokens = measure('cleanupMs', () => cleanupTokens(tokens));
+    tokens = measure('groupMs', () => groupTextTokens(tokens));
+    tokens = measure('listTransformMs', () => omitListItemParagraph(tokens));
+    const ast = measure('astMs', () => tokensToAST(tokens));
+    const result = measure('elementsMs', () => renderer(ast));
+    stages.totalMs = performance.now() - start;
+    onPerformance(stages);
+    return result;
+  }
   if (Array.isArray(source)) {
     return renderer(source);
   }
