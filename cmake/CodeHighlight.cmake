# The same resolver is used by Gradle/CMake and CocoaPods.
function(vali_configure_highlighting target)
  get_filename_component(vali_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  if(NOT VALI_MARKDOWN_APP_PACKAGE_JSON)
    set(VALI_MARKDOWN_APP_PACKAGE_JSON "${vali_root}/package.json")
  endif()
  find_program(VALI_NODE_EXECUTABLE node REQUIRED)
  execute_process(COMMAND "${VALI_NODE_EXECUTABLE}" "${vali_root}/scripts/highlight-config.cjs" "${VALI_MARKDOWN_APP_PACKAGE_JSON}"
    RESULT_VARIABLE config_result OUTPUT_VARIABLE config ERROR_VARIABLE config_error)
  if(NOT config_result EQUAL 0)
    message(FATAL_ERROR "${config_error}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${VALI_MARKDOWN_APP_PACKAGE_JSON}" "${vali_root}/scripts/highlight-config.cjs")
  string(JSON enabled GET "${config}" enabled)
  if(NOT enabled)
    message(STATUS "ValiMarkdown: code highlighting disabled")
    return()
  endif()
  string(JSON source_count LENGTH "${config}" sources)
  math(EXPR source_last "${source_count} - 1")
  foreach(index RANGE ${source_last})
    string(JSON source GET "${config}" sources ${index})
    target_sources(${target} PRIVATE "${vali_root}/${source}")
    get_filename_component(source_directory "${vali_root}/${source}" DIRECTORY)
    set_source_files_properties("${vali_root}/${source}" PROPERTIES INCLUDE_DIRECTORIES "${source_directory}")
  endforeach()
  string(JSON define_count LENGTH "${config}" defines)
  math(EXPR define_last "${define_count} - 1")
  foreach(index RANGE ${define_last})
    string(JSON define GET "${config}" defines ${index})
    target_compile_definitions(${target} PRIVATE "${define}")
  endforeach()
  target_include_directories(${target} PRIVATE "${vali_root}/vendor/tree-sitter/runtime/lib/include" "${vali_root}/vendor/tree-sitter/typescript/typescript/src")
  set_property(TARGET ${target} PROPERTY C_STANDARD 11)
  string(JSON languages GET "${config}" languages)
  message(STATUS "ValiMarkdown code highlight languages: ${languages}")
endfunction()
